generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum PriceModifiers {
  addition
  multiplication
}

  enum VariantsType {
    color
    size
    material
    style
    other
    denomination
    discount
  }

enum OfferType {
  Link
  Registration_Service
  Coupon
  ContactMe
  Purchase
  Voucher
}

enum OfferStatus {
  active
  inactive
  demo
}

enum MerchantStatus {
  pending
  active
  suspended
  inactive
}

enum PaymeStatus {
  pending
  approved
  rejected
}

enum KycStatus {
  not_started
  in_progress
  approved
  rejected
}

enum TenantStatus {
  active
  inactive
  pending
}

enum PurchaseStatus {
  pending
  authorized
  completed
  failed
  refunded
  chargebacked
  cancelled
}

enum CouponStatus {
  available
  used
}

model Tenant {
  id                  String   @id @default(uuid()) @db.Uuid
  tenant_id           String?
  name   String
  type   String?
  title               String?
  image               String?

  contact_first_name  String?
  contact_last_name   String?
  email               String?
  phone               String?
  status              String?
  join_date           DateTime? @default(now()) @db.Date
  official_site_url   String?
  newsletter_status   Boolean?
  official_sign_up    String?
  official_login      String?
  report_email         String?

  offers TenantsOffers[]
  excludedOffers OfferExcludedTenants[]
  users User[]
  coupons Coupon[]
  @@map("Tenants")
}

model Merchant {
  id               String       @id @default(uuid()) @db.Uuid
  business_name             String   
  contact_name              String  
  email                     String    
  phone                     String   
  address                   String?   
  city                      String?  
  business_category         String?   
  business_registration_number String 
  business_type             String    
  vat_number                String?   
  website_url               String?   
  bank_name                 String    
  bank_branch               String    
  bank_account              String    
  bank_account_holder       String    
  commission_rate           Decimal   
  payment_terms             String?   
  status                    MerchantStatus @default(pending)
  join_date                 DateTime  @default(now())
  approval_date             DateTime?

  payme_seller_id           String?   
  payme_api_key             String?   
  payme_status              PaymeStatus?
  kyc_status                KycStatus @default(not_started)
  documents_uploaded        Json?
  notes                     String?  

  offers MerchantsOffers[]

  @@map("Merchants")
}

model MerchantsOffers {
  id            String   @id @default(uuid()) @db.Uuid
  merchant   Merchant? @relation(fields: [merchant_id], references: [id])
  merchant_id         String? @db.Uuid

  base_price          Decimal?
  status            OfferStatus @default(active)
  title               String  
  subtitle             String?
  description         String?
  images           String?  
  type          OfferType?
  category            String?
  available_quantity  Int?      @default(0)
  time_limit          Int?      // in days; used for Voucher offers to compute per-purchase expiration
  excludedTenantsCol  String? // Comma-separated list of tenant IDs to exclude
  expiration_date         DateTime?
  created_date        DateTime @default(now())
  updated_date        DateTime? @updatedAt

  options       VariantOption[]
  tenants TenantsOffers[]
  excludedTenants OfferExcludedTenants[]
  purchases Purchase[]
  OfferVariants  OfferVariant[]
  coupons Coupon[]

  @@map("MerchantsOffers")
}

model VariantOption {
  id        String   @id @default(uuid()) @db.Uuid
  offerId   String   @db.Uuid
  offer     MerchantsOffers    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  name      String
  values    VariantOptionValue[]

  @@unique([offerId, name])
}

model VariantOptionValue {
  id        String   @id @default(uuid()) @db.Uuid
  optionId  String   @db.Uuid
  option    VariantOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  value     String

  priceModifier  PriceModifiers
  priceValue Decimal   // e.g., +10, -5, 15%

  variantConnections OfferVariantValue[]

  @@index([optionId])
}

model OfferVariant {
  id            String   @id @default(uuid()) @db.Uuid

  offerId       String   @db.Uuid
  offer         MerchantsOffers    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sku           String   @unique
  barcode       String?  @unique
  stock_quantity Int
  price Decimal
  title         String?
  summary      String?
  terms         String?
  images String[]

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  values        OfferVariantValue[]
    tenantsOffers TenantsOffers[]
  purchases     Purchase[]
  coupons       Coupon[]

  @@index([offerId])
}

model OfferVariantValue {
  variantId String @db.Uuid
  valueId   String @db.Uuid

  variant   OfferVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value     VariantOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([variantId, valueId])
}



model TenantsOffers {
  id              String           @id @default(uuid()) @db.Uuid
  tenant          Tenant?          @relation(fields: [tenant_id], references: [id])
  tenant_id       String?          @db.Uuid
  offer           MerchantsOffers? @relation(fields: [offer_id], references: [id])
  offer_id        String?          @db.Uuid

  offerVariant        OfferVariant? @relation(fields: [offer_variant_id], references: [id])
  offer_variant_id    String?       @db.Uuid

  tenant_price    Decimal?

  @@unique([tenant_id, offer_variant_id])

  @@map("TenantsOffers")
}

model OfferExcludedTenants {
  offer       MerchantsOffers     @relation(fields: [offerId], references: [id])
  offerId  String @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  tenantId String @db.Uuid

  @@id([offerId, tenantId])
}

model User {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  email     String  @unique
  phone     String?
  tenant    Tenant? @relation(fields: [tenant_id], references: [id])
  tenant_id String? @db.Uuid

  purchases Purchase[]

  @@map("Users")
}

model Purchase {
  id                   String          @id @default(uuid()) @db.Uuid
  offer                MerchantsOffers? @relation(fields: [offer_id], references: [id])
  offer_id             String?         @db.Uuid
  user                 User?           @relation(fields: [user_id], references: [id])
  user_id              String?         @db.Uuid

  offerVariant         OfferVariant?   @relation(fields: [offer_variant_id], references: [id])
  offer_variant_id     String?         @db.Uuid

  tenant_id            String?
  amount               Decimal
  currency             String          @default("ILS")
  transaction_id       String          @unique
  payme_sale_id        String?
  payme_sale_code      Int?
  payme_transaction_id String?
  sale_url             String?
  expiration_date      DateTime?
  status               PurchaseStatus  @default(pending)
  receipt_details      Json?
  created_at           DateTime        @default(now())
  updated_at           DateTime?       @updatedAt

  coupon Coupon?

  @@map("Purchases")
}

model Coupon {
  id                 String          @id @default(uuid()) @db.Uuid
  offer              MerchantsOffers @relation(fields: [offer_id], references: [id])
  offer_id           String          @db.Uuid

  offerVariant       OfferVariant?   @relation(fields: [offer_variant_id], references: [id])
  offer_variant_id   String?         @db.Uuid

  tenant             Tenant          @relation(fields: [tenant_id], references: [id])
  tenant_id          String          @db.Uuid
  purchase           Purchase?       @relation(fields: [purchase_id], references: [id])
  purchase_id        String?         @unique @db.Uuid

  barcode            String?
  sku                String?
  price              Decimal?
  cost               Decimal?
  price_for_consumer Decimal?
  email_template_id  Int?
  user_email         String?
  issued_date        DateTime?
  expired_date       DateTime?
  status             CouponStatus    @default(available)
  created_at         DateTime        @default(now())
  updated_at         DateTime?       @updatedAt

  @@map("Coupons")
}