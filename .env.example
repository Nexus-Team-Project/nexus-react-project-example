# This file lists required environment variables without real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_test
JWT_SECRET=replace-with-long-random-secret-at-least-32-chars
PARTNER_API_TOKEN_HASH=replace-with-seeded-token-hash-or-unused
ALLOW_PARTNER_STATUS_READS=true
PAYME_ENV=sandbox
PAYME_API_KEY=replace-with-payme-mpl-key
PAYME_BASE_URL=https://sandbox.payme.io/api/
PAYME_SELLER_ID=MPLDEMO-MPLDEMO-MPLDEMO-1234567
PAYME_WEBHOOK_SECRET=replace-with-payme-callback-secret-if-provided
PUBLIC_API_BASE_URL=http://localhost:3000
PAYMENT_SUCCESS_URL=http://localhost:3000/test/payment/success
PAYMENT_FAILURE_URL=http://localhost:3000/test/payment/failure
